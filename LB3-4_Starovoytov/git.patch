+            FilterResetButton.Click -= FilterResetButton_Click;
+            FilterResetButton.Click += FilterResetButton_Clicked;
+            toolStripSaveMenuItem.Click -= toolStripSaveMenuItem_Click;
+            toolStripSaveMenuItem.Click += ToolStripSaveMenuItem_Clicked;
+            toolStripLoadMenuItem.Click -= toolStripLoadMenuItem_Click;
+            toolStripLoadMenuItem.Click += ToolStripLoadMenuItem_Clicked;
